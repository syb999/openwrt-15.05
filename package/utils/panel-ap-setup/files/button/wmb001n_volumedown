#!/bin/sh
# Volume down: step the SoC digital volume ("Master").  That register sits in
# front of both the I2S and the S/PDIF serializer, so it is the one volume
# that also works on the optical port.  The wm8904 codec controls only reach
# the headphone output and are therefore kept at a fixed level.
# PISEN WMB001N volume bar: pisen:blue:volum0..4 (GPIO0-4).

STEP=1
MIN=0
CTL="Master"

case "$ACTION" in
released)
	cur=$(amixer get "$CTL" 2>/dev/null | awk 'match($0, /Playback [0-9]+/) { v = substr($0, RSTART + 9, RLENGTH - 9) } END { if (v != "") print v }')
	[ -n "$cur" ] || cur="$MIN"
	new=$((cur - STEP))
	[ "$new" -lt "$MIN" ] && new=$MIN

	amixer -q set "$CTL" "$new" >/dev/null 2>&1

	# fixed codec level: the SoC volume is the master
	amixer -q set "Digital" 86 >/dev/null 2>&1
	amixer -q set "Headphone" 100% >/dev/null 2>&1
	amixer -q set "Line Output" 100% >/dev/null 2>&1

	pct=$(amixer get "$CTL" 2>/dev/null | awk 'match($0, /[0-9]+%/) { print substr($0, RSTART, RLENGTH - 1); exit }')
	[ -n "$pct" ] || pct=0

	level=5
	[ "$pct" -le 80 ] && level=4
	[ "$pct" -le 60 ] && level=3
	[ "$pct" -le 40 ] && level=2
	[ "$pct" -le 20 ] && level=1

	i=0
	while [ $i -le 4 ]; do
		if [ $i -lt $level ]; then
			echo 1 > /sys/devices/platform/leds-gpio/leds/pisen:blue:volum$i/brightness
		else
			echo 0 > /sys/devices/platform/leds-gpio/leds/pisen:blue:volum$i/brightness
		fi
		i=$((i + 1))
	done
	;;
esac
