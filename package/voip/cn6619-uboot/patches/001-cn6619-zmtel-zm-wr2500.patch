--- a/u-boot/cpu/mips/ar7240/qca95xx_pll_init.S
+++ b/u-boot/cpu/mips/ar7240/qca95xx_pll_init.S
@@ -471,6 +471,39 @@
 	li   t8, 0x00C00000
 	subu ra, ra, t8
 
+	/*
+	 * CN6619 / ZM-WR2500 (ZMTEL) board additions.
+	 *
+	 * The following registers are WRITE-LOCKED once the system is running
+	 * (writing them later resets the SoC), so they must be programmed here,
+	 * during low-level init -- exactly like the vendor U-Boot does.
+	 *
+	 *   0x18050004  AUDIO PLL control   (vendor U-Boot writes 0x40818xxx)
+	 *   0x18050028  audio clock divider
+	 *   0x180a0000  TDM interface config
+	 *   0x180a0004  TDM interface enable (bit12+bit16 needed!)
+	 *   0x180a0050  MBOX DMA control
+	 *
+	 * Without 0x180a0004's enable bits the MBOX DMA engine has no clock,
+	 * stops right after start and the SLIC PCM data never reaches memory
+	 * (handset completely silent).
+	 */
+	li	t7, 0xb8050004
+	li	t8, 0x40818000
+	sw	t8, 0(t7)
+	li	t7, 0xb8050028
+	li	t8, 0x00098000
+	sw	t8, 0(t7)
+	li	t7, 0xb80a0000
+	li	t8, 0x00010016
+	sw	t8, 0(t7)
+	li	t7, 0xb80a0004
+	li	t8, 0x000110ff
+	sw	t8, 0(t7)
+	li	t7, 0xb80a0050
+	li	t8, 0x00000050
+	sw	t8, 0(t7)
+
 end:
 	jr ra
 	nop
