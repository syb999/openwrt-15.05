+++ b/u-boot/common/main.c
@@ -196,6 +196,20 @@ void main_loop(void)
 /* Recovery mode before normal boot */
 #if defined(CONFIG_BTN_RECOVERY_SCRIPT) &&\
     defined(CONFIG_GPIO_RESET_BTN)
+	/* 🔴 Watch the button for a few seconds instead of sampling it once.
+	 * Holding reset asserts the SoC hardware reset, so when U-Boot finally
+	 * starts running the operator may have just released the key - the
+	 * single-shot test then saw "not pressed" and skipped recovery entirely
+	 * (observed on ZM-WR2500: "hold reset + power on" only ever dropped to
+	 * the u-boot> prompt).  Poll for up to ~5 s and take the button as
+	 * pressed if it is down at any point in that window. */
+	{
+		int btn_wait = 0;
+		while (btn_wait < 50 && !reset_button_status()) {
+			udelay(100000);	/* 100 ms */
+			btn_wait++;
+		}
+	}
 	if (reset_button_status()) {
 		#if defined(CONFIG_SILENT_CONSOLE)
 		if (gd->flags & GD_FLG_SILENT) {
