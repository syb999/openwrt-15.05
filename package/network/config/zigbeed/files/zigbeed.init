#!/bin/sh /etc/rc.common
# zigbeed - independent Zigbee gateway daemon (replaces vendor DeviceHub)
# EFR32MG1B coordinator on ttyS1, GPIO36 reset

START=95
STOP=10

PROG=/usr/bin/zigbeed
PIDFILE=/var/run/zigbeed.pid

start_service() {
	# stop vendor DeviceHub if present (it owns ttyS1)
	if [ -x /etc/init.d/DeviceHub ]; then
		/etc/init.d/DeviceHub stop 2>/dev/null
	fi

	local enabled
	config_load zigbeed
	config_get_bool enabled options 'enabled' 0
	[ "$enabled" -eq 1 ] || return 0

	local device baud poll
	config_get device options 'device' '/dev/ttyS1'
	config_get baud options 'baud' '115200'
	config_get poll options 'poll_interval' '30'

	procd_open_instance
	procd_set_param command "$PROG" -d -dev "$device" -baud "$baud"
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile $PIDFILE
	procd_close_instance
}

stop_service() {
	service_stop "$PROG"
}

EXTRA_COMMANDS="status"
EXTRA_HELP="	status	Show coordinator status JSON"

status() {
	$PROG -status 2>&1
}
