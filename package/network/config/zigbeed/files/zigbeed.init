#!/bin/sh /etc/rc.common
# zigbeed - Zigbee gateway frontend (EFR32MG1B coordinator)
#
# Architecture (2026-09-12): the vendor DeviceHub is the permanent radio owner.
# Only its host session is fully authorised by the coordinator, so with it
# running the network stays intact and every device report arrives. zigbeed
# detects DeviceHub (pidof) and then works as the frontend: it does not touch
# the serial port and takes the device states from the vendor's log stream
# (gem_device_state_cb) plus the network parameters from /etc/IoT/CoorInfo.json.
# Without DeviceHub it falls back to owning the serial itself.
#
# START order: devicehub (93) -> zigbeed (96)

START=96
STOP=10

PROG=/usr/bin/zigbeed
PIDFILE=/var/run/zigbeed.pid

start() {
	# make sure the radio owner is up first
	if [ -x /etc/init.d/devicehub ]; then
		pidof DeviceHub >/dev/null 2>&1 || /etc/init.d/devicehub start
	fi
	sleep 1

	config_load zigbeed
	config_get_bool enabled options 'enabled' 0
	[ "$enabled" -eq 1 ] || return 0

	config_get_bool mqtt options 'mqtt' 0
	config_get mqtt_host options 'mqtt_host' '127.0.0.1'
	config_get mqtt_port options 'mqtt_port' '1883'

	local ARGS="-d -serve 8888"
	[ "$mqtt" -eq 1 ] && ARGS="$ARGS -mqtt $mqtt_host $mqtt_port"

	# already running? never start twice (serial conflicts)
	if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
		return 0
	fi

	$PROG $ARGS > /tmp/zb.log 2>&1 &
	echo $! > "$PIDFILE"
}

stop() {
	[ -f "$PIDFILE" ] && kill "$(cat $PIDFILE)" 2>/dev/null
	killall zigbeed 2>/dev/null
	rm -f "$PIDFILE"
}

EXTRA_COMMANDS="status"
EXTRA_HELP="	status	Show coordinator status JSON"

status() {
	$PROG -status 2>&1
}
