#!/bin/sh /etc/rc.common
# zigbeed - independent Zigbee gateway daemon (EFR32MG1B coordinator)
# 重要: 不用 USE_PROCD (rc.common procd 分支在这固件有问题, 且 procd respawn
#       会在进程退出后自动拉起 → 串口断开 → 协调器固件恢复默认并清 NVRAM!)
# 用旧风格 start()/stop() + 手动后台启动, 进程保持常驻

START=95
STOP=10

PROG=/usr/bin/zigbeed
PIDFILE=/var/run/zigbeed.pid

start() {
	# stop vendor DeviceHub if present (it owns ttyS1)
	if [ -x /etc/init.d/DeviceHub ]; then
		/etc/init.d/DeviceHub stop 2>/dev/null
	fi
	killall DeviceHub 2>/dev/null
	sleep 1

	config_load zigbeed
	config_get_bool enabled options 'enabled' 0
	[ "$enabled" -eq 1 ] || return 0

	config_get_bool mqtt options 'mqtt' 0
	config_get mqtt_host options 'mqtt_host' '127.0.0.1'
	config_get mqtt_port options 'mqtt_port' '1883'

	local ARGS="-d -serve 8888"
	[ "$mqtt" -eq 1 ] && ARGS="$ARGS -mqtt $mqtt_host $mqtt_port"

	# 已在运行则跳过 (绝不重复启动, 避免串口冲突)
	if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
		return 0
	fi

	$PROG $ARGS > /tmp/zb.log 2>&1 &
	echo $! > "$PIDFILE"
}

stop() {
	[ -f "$PIDFILE" ] && kill "$(cat $PIDFILE)" 2>/dev/null
	killall zigbeed 2>/dev/null
	rm -f "$PIDFILE"
}

EXTRA_COMMANDS="status"
EXTRA_HELP="	status	Show coordinator status JSON"

status() {
	$PROG -status 2>&1
}
