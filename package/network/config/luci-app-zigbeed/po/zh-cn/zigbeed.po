msgstr "MQTT 桥接"

msgid "MQTT bridge: connects to local mosquitto (1883), publishes device state and subscribes control commands. Use with Home Assistant via zigbee2mqtt-style topics."
msgstr "MQTT 桥接：连接本地 mosquitto (1883)，发布设备状态并订阅控制命令。可通过 zigbee2mqtt 风格主题配合 Home Assistant 使用。"

msgid "Leave channel/PAN ID/extended PAN ID/network key empty - real values are read from the coordinator and shown on Status page."
msgstr "信道/PAN ID/扩展 PAN ID/网络密钥留空 - 实际值从协调器读取并显示在状态页。"

msgid "Save &amp; Apply"
msgstr "保存并应用"

msgid "Rebuild coordinator network? This temporarily starts the vendor DeviceHub to reform the network."
msgstr "重建协调器网络？将临时启动原厂 DeviceHub 重新建网。"

msgid "Rebuild started, waiting (~60s)..."
msgstr "重建已启动，等待（约60秒）..."

msgid "Rebuild started, checking..."
msgstr "重建已启动，检查中..."

msgid "Timeout, check /tmp/zigbeed_rebuild.log"
msgstr "超时，请查看 /tmp/zigbeed_rebuild.log"

