#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	enabled=$(uci get i2c-ssd1306.@i2c-ssd1306[0].enabled)
	if [ $enabled -eq 0 ]; then
		return 0
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/i2c_ssd1306 \
		-i "$(uci get i2c-ssd1306.@i2c-ssd1306[0].i2c_bus)" \
		-a "$(uci get i2c-ssd1306.@i2c-ssd1306[0].i2c_address)" \
		-l "$(uci get i2c-ssd1306.@i2c-ssd1306[0].log_file)"
    
	procd_set_param respawn
	procd_close_instance

	log_file=$(uci get i2c-ssd1306.@i2c-ssd1306[0].log_file)
	[ -z "$log_file" ] && log_file=/var/log/ssd1306.log
	screen_type=$(uci get i2c-ssd1306.@i2c-ssd1306[0].screen_type)

	# 96x16 (SSD1315) only has 2 rows: time + WAN IP. Other panels get 4 rows.
	# Regenerate when the line count no longer matches, so switching
	# screen_type and restarting rewrites the log automatically.
	expected_lines=4
	[ "$screen_type" = "96x16" ] && expected_lines=2
	actual_lines=$(wc -l < "$log_file" 2>/dev/null || echo 0)

	if [ ! -f "$log_file" -o ! -s "$log_file" -o "$actual_lines" -ne "$expected_lines" ]; then
		if [ "$expected_lines" = "2" ]; then
			# 96x16: no leading spaces. The 4x6 font steps 5px/char, so
			# 19 chars = 95px already fills the 96px panel; "WAN:255.255.255.255"
			# (19 chars) would overflow with any indent.
			echo "\$(date '+%m-%d %H:%M:%S')" > "$log_file"
			echo "WAN:\$(ifstatus wan | jsonfilter -e '@[\"ipv4-address\"][0].address')" >> "$log_file"
		else
			echo "  \$(date '+%m-%d %H:%M:%S')" > "$log_file"
			echo "  HELLO, OPENWRT!" >> "$log_file"
			echo "  LAN:\$(ifstatus lan | jsonfilter -e '@[\"ipv4-address\"][0].address')" >> "$log_file"
			echo "  WAN:\$(ifstatus wan | jsonfilter -e '@[\"ipv4-address\"][0].address')" >> "$log_file"
		fi
	fi
}

stop_service() {
    killall i2c_ssd1306
}

restart() {
    stop
    start
}
