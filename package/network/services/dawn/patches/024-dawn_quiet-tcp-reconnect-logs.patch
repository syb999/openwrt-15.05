@@ -93,14 +94,15 @@ static void client_to_server_close(struct ustream *s) {
 }
 
 static void client_to_server_state(struct ustream *s) {
-    struct client *cl = container_of(s, struct client, s.stream);
-
+    /* Note: the stream belongs to a network_con_s, not to a struct client.
+     * The old code used container_of() with the wrong type and then printed
