diff --git a/src/network/tcpsocket.c b/src/network/tcpsocket.c
index 7a86e89..0c454ef 100644
--- a/src/network/tcpsocket.c
+++ b/src/network/tcpsocket.c
@@ -51,7 +51,7 @@ static void client_close(struct ustream *s) {
 
     struct client *cl = container_of(s, struct client, s.stream);
 
-    dawnlog_warning("Connection closed\n");
+    dawnlog_info("Client connection closed\n");
     ustream_free(s);
     dawn_unregmem(s);
     close(cl->s.fd.fd);
@@ -69,11 +69,12 @@ static void client_notify_write(struct ustream *s, int bytes) {
 static void client_notify_state(struct ustream *s) {
     dawnlog_debug_func("Entering...");
 
-    struct client *cl = container_of(s, struct client, s.stream);
     if (!s->write_error && !s->eof)
         return;
 
