+/* ------------------------------------------------------------------------
+ * assoclist cache
+ *
+ * get_rssi()/get_bandwidth()/get_expected_throughput() look up one client at
+ * a time, but every lookup used to open the iwinfo backend and dump the
+ * complete station table of the interface. update_iw_info() walks all clients
+ * of a BSS one by one, so a 2.4 GHz AP with 50 clients performed 50 netlink
+ * dumps per update cycle. Cache the dump for a second and let all clients of
+ * the same interface share it.
+ */
+#define ASSOC_CACHE_ENTRIES 4
+#define ASSOC_CACHE_TTL     1
+
+struct assoc_cache_entry {
+    char ifname[64];
+    int len;
+    time_t time;
+};
+
+static struct assoc_cache_entry assoc_cache[ASSOC_CACHE_ENTRIES];
+static char assoc_cache_buf[IWINFO_BUFSIZE];
+
+static char *assoclist_cached(const char *ifname, int *len)
+{
+    time_t now = time(NULL);
+    int slot = -1;
+    int i;
+
+    for (i = 0; i < ASSOC_CACHE_ENTRIES; i++) {
+        if (!assoc_cache[i].ifname[0])
+            continue;
+        if (strcmp(assoc_cache[i].ifname, ifname))
+            continue;
+        if ((now - assoc_cache[i].time) <= ASSOC_CACHE_TTL) {
+            *len = assoc_cache[i].len;
+            return assoc_cache_buf;
+        }
+        slot = i;
+    }
+
+    const struct iwinfo_ops *iw = iwinfo_backend(ifname);
+    if (!iw) {
+        dawnlog_trace("No iwinfo backend for %s\n", ifname);
+        return NULL;
+    }
+
+    int l = 0;
+    int rc = iw->assoclist(ifname, assoc_cache_buf, &l);
+    iwinfo_finish();
+
+    if (rc || l <= 0) {
+        dawnlog_trace("No information available\n");
+        *len = 0;
+        return NULL;
+    }
+
+    if (slot < 0) {
+        slot = 0;
+        for (i = 0; i < ASSOC_CACHE_ENTRIES; i++) {
+            if (!assoc_cache[i].ifname[0]) {
+                slot = i;
+                break;
+            }
+        }
+    }
+
+    snprintf(assoc_cache[slot].ifname, sizeof(assoc_cache[slot].ifname), "%s", ifname);
+    assoc_cache[slot].len = l;
+    assoc_cache[slot].time = now;
+
+    *len = l;
+    return assoc_cache_buf;
+}
