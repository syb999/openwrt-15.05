config local
	option loglevel '0'

config network
	option broadcast_ip '10.0.0.255'
	option broadcast_port '1025'
	option tcp_port '1026'
	# 2 = TCP with uMDNS discovery - the right choice for several APs
	option network_option '2'
	# must be identical on every AP
	option shared_key 'Niiiiiiiiiiiiiick'
	option iv 'Niiiiiiiiiiiiiick'
	option use_symm_enc '0'
	option collision_domain '-1'
	option bandwidth '-1'

config hostapd
	option hostapd_dir '/var/run/hostapd'

config times
	option con_timeout '60'
	# one scoring/kicking cycle every 15s - enough for a handful of APs
	option update_client '15'
	option remove_client '30'
	option remove_probe '60'
	option remove_ap '460'
	option update_hostapd '10'
	option update_tcp_con '10'
	option update_chan_util '5'
	# 802.11k is off by default, so do not ask clients for beacon reports
	option update_beacon_reports '0'

config metric 'global'
	option min_probe_count '3'
	option bandwidth_threshold '3'
	option use_station_count '0'
	option max_station_diff '1'
	option eval_probe_req '0'
	option eval_auth_req '0'
	option eval_assoc_req '0'
	# 2 = 802.11v BTM request only, no forced disconnect
	option kicking '2'
	# 25 leaves room for the RSSI offset between mt76 and ath9k
	option kicking_threshold '35'
	option deny_auth_reason '1'
	option deny_assoc_reason '17'
	option min_number_to_kick '6'
	option chan_util_avg_period '3'
	option set_hostapd_nr '1'
	option disassoc_nr_length '6'
	option duration '150'
	option rrm_mode 'pat'

config metric '802_11g'
	# lower than 5GHz so clients prefer the 5GHz radio
	option initial_score '75'
	option ht_support '5'
	option vht_support '5'
	option no_ht_support '0'
	option no_vht_support '0'
	option rssi '15'
	option rssi_val '-60'
	option low_rssi_val '-80'
	option low_rssi '-15'
	option chan_util '0'
	option chan_util_val '140'
	option max_chan_util '-15'
	option max_chan_util_val '170'
	option rssi_weight '0'
	option rssi_center '-72'

config metric '802_11a'
	option initial_score '100'
	option ht_support '5'
	option vht_support '5'
	option no_ht_support '0'
	option no_vht_support '0'
	option rssi '15'
	option rssi_val '-60'
	option low_rssi_val '-80'
	option low_rssi '-15'
	option chan_util '0'
	option chan_util_val '140'
	option max_chan_util '-15'
	option max_chan_util_val '170'
	option rssi_weight '0'
	option rssi_center '-78'
